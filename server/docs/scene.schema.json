{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/teofurlan/socra/server/docs/scene.schema.json",
  "title": "Socra narrated scene",
  "description": "What Socra says (steps), what it shows (objects) and cues that bind visual actions to the moment a step starts speaking. The server also checks what a schema cannot: ids that cues reference, one cue per step, actions allowed by each primitive, line ranges inside the code and headline length after trimming, diagram node and edge references, and that a traced path follows existing edges.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "steps"],
  "properties": {
    "version": { "const": 1 },
    "title": { "type": "string", "pattern": "\\S" },
    "objects": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "primitive", "params"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "primitive": { "enum": ["code", "headline", "shape", "diagram"] },
          "params": { "type": "object" },
          "hidden": { "type": "boolean", "default": false, "description": "Start hidden; a show action reveals it." }
        },
        "allOf": [
          {
            "if": { "properties": { "primitive": { "const": "code" } } },
            "then": { "properties": { "params": { "$ref": "#/$defs/codeParams" } } }
          },
          {
            "if": { "properties": { "primitive": { "const": "headline" } } },
            "then": { "properties": { "params": { "$ref": "#/$defs/headlineParams" } } }
          },
          {
            "if": { "properties": { "primitive": { "const": "shape" } } },
            "then": { "properties": { "params": { "$ref": "#/$defs/shapeParams" } } }
          },
          {
            "if": { "properties": { "primitive": { "const": "diagram" } } },
            "then": { "properties": { "params": { "$ref": "#/$defs/diagramParams" } } }
          }
        ]
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "say"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "say": { "type": "string", "pattern": "\\S", "description": "Spoken on its own; synthesized per step." }
        }
      }
    },
    "cues": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "do"],
        "properties": {
          "at": { "$ref": "#/$defs/id", "description": "The step whose start triggers these actions." },
          "do": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": { "$ref": "#/$defs/action" }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "codeParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "description": "Shown verbatim." },
        "language": { "type": "string", "default": "", "description": "Only affects syntax colours." }
      }
    },
    "headlineParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "$ref": "#/$defs/headlineText" }
      }
    },
    "headlineText": {
      "type": "string",
      "pattern": "^[^\\n\\r]*\\S[^\\n\\r]*$",
      "maxLength": 24,
      "description": "A title or key term on one line, drawn large with particles. Trimmed; at most 24 characters after trimming."
    },
    "shapeParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape"],
      "properties": {
        "shape": { "enum": ["cube", "cylinder", "cone", "sphere", "torus"] },
        "wireframe": { "type": "boolean", "default": false }
      }
    },
    "diagramParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes"],
      "description": "Boxes and arrows laid out by the page; the model never gives coordinates.",
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 25,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "label": { "$ref": "#/$defs/diagramLine", "maxLength": 40 },
              "group": { "type": "string", "maxLength": 24, "description": "Nodes of the same group share a tint." }
            }
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 60,
          "description": "Directed; both ends must be declared nodes, different from each other; no repeated from/to pair.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": { "$ref": "#/$defs/id" },
              "to": { "$ref": "#/$defs/id" },
              "label": { "type": "string", "maxLength": 30 },
              "hidden": { "type": "boolean", "default": false, "description": "Drawn only after a reveal or trace." }
            }
          }
        },
        "direction": { "enum": ["TB", "LR"], "default": "LR" }
      }
    },
    "diagramLine": {
      "type": "string",
      "pattern": "^[^\\n\\r]*\\S[^\\n\\r]*$"
    },
    "diagramNodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": { "$ref": "#/$defs/id" }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object", "action"],
      "properties": {
        "object": { "$ref": "#/$defs/id" },
        "action": { "enum": ["show", "hide", "focus", "clear", "set", "rotate", "reset", "highlight", "dim", "reveal", "trace", "annotate"] },
        "params": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "focus" } } },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["lines"],
                "properties": {
                  "lines": {
                    "type": "array",
                    "prefixItems": [{ "type": "integer", "minimum": 1 }, { "type": "integer", "minimum": 1 }],
                    "minItems": 2,
                    "maxItems": 2,
                    "description": "[start, end], 1-based and inclusive."
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "rotate" } } },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "rx": { "type": "number" },
                  "ry": { "type": "number" },
                  "rz": { "type": "number" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "set" } } },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "text": { "$ref": "#/$defs/headlineText" },
                  "shape": { "enum": ["cube", "cylinder", "cone", "sphere", "torus"] },
                  "wireframe": { "type": "boolean" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "action": { "enum": ["highlight", "dim"] } } },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["nodes"],
                "properties": { "nodes": { "$ref": "#/$defs/diagramNodes" } }
              }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "reveal" } } },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["from", "to"],
                "properties": { "from": { "$ref": "#/$defs/id" }, "to": { "$ref": "#/$defs/id" } }
              }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "trace" } } },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path"],
                "properties": {
                  "path": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 30,
                    "items": { "$ref": "#/$defs/id" },
                    "description": "Each consecutive pair must be an edge, in its direction."
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "annotate" } } },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["node", "text"],
                "properties": {
                  "node": { "$ref": "#/$defs/id" },
                  "text": { "$ref": "#/$defs/diagramLine", "maxLength": 60 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "action": { "enum": ["show", "hide", "clear", "reset"] } } },
          "then": { "properties": { "params": { "type": "object", "maxProperties": 0 } } }
        }
      ]
    }
  }
}
