{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/teofurlan/socra/server/docs/scene.schema.json",
  "title": "Socra narrated scene",
  "description": "What Socra says (steps), what it shows (objects) and cues that bind visual actions to the moment a step starts speaking. The server also checks what a schema cannot: ids that cues reference, one cue per step, actions allowed by each primitive, line ranges inside the code and headline length after trimming, diagram node and edge references, that a traced path follows existing edges, and every structure operation by simulating the cues in step order (popping an empty stack, an index out of range or removing a missing key are rejected).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "steps"],
  "properties": {
    "version": { "const": 1 },
    "title": { "type": "string", "pattern": "\\S" },
    "objects": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "primitive", "params"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "primitive": { "enum": ["code", "headline", "shape", "diagram", "structure"] },
          "params": { "type": "object" },
          "hidden": { "type": "boolean", "default": false, "description": "Start hidden; a show action reveals it." }
        },
        "allOf": [
          {
            "if": { "properties": { "primitive": { "const": "code" } } },
            "then": { "properties": { "params": { "$ref": "#/$defs/codeParams" } } }
          },
          {
            "if": { "properties": { "primitive": { "const": "headline" } } },
            "then": { "properties": { "params": { "$ref": "#/$defs/headlineParams" } } }
          },
          {
            "if": { "properties": { "primitive": { "const": "shape" } } },
            "then": { "properties": { "params": { "$ref": "#/$defs/shapeParams" } } }
          },
          {
            "if": { "properties": { "primitive": { "const": "diagram" } } },
            "then": { "properties": { "params": { "$ref": "#/$defs/diagramParams" } } }
          },
          {
            "if": { "properties": { "primitive": { "const": "structure" } } },
            "then": { "properties": { "params": { "$ref": "#/$defs/structureParams" } } }
          }
        ]
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "say"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "say": { "type": "string", "pattern": "\\S", "description": "Spoken on its own; synthesized per step." }
        }
      }
    },
    "cues": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "do"],
        "properties": {
          "at": { "$ref": "#/$defs/id", "description": "The step whose start triggers these actions." },
          "do": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": { "$ref": "#/$defs/action" }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "codeParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "description": "Shown verbatim." },
        "language": { "type": "string", "default": "", "description": "Only affects syntax colours." }
      }
    },
    "headlineParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "$ref": "#/$defs/headlineText" }
      }
    },
    "headlineText": {
      "type": "string",
      "pattern": "^[^\\n\\r]*\\S[^\\n\\r]*$",
      "maxLength": 24,
      "description": "A title or key term on one line, drawn large with particles. Trimmed; at most 24 characters after trimming."
    },
    "shapeParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape"],
      "properties": {
        "shape": { "enum": ["cube", "cylinder", "cone", "sphere", "torus"] },
        "wireframe": { "type": "boolean", "default": false }
      }
    },
    "diagramParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes"],
      "description": "Boxes and arrows laid out by the page; the model never gives coordinates.",
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 25,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "label": { "$ref": "#/$defs/diagramLine", "maxLength": 40 },
              "group": { "type": "string", "maxLength": 24, "description": "Nodes of the same group share a tint." }
            }
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 60,
          "description": "Directed; both ends must be declared nodes, different from each other; no repeated from/to pair.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": { "$ref": "#/$defs/id" },
              "to": { "$ref": "#/$defs/id" },
              "label": { "type": "string", "maxLength": 30 },
              "hidden": { "type": "boolean", "default": false, "description": "Drawn only after a reveal or trace." }
            }
          }
        },
        "direction": { "enum": ["TB", "LR"], "default": "LR" }
      }
    },
    "structureValue": {
      "description": "A whole number between -9999 and 9999, or one line of text of at most 8 characters.",
      "oneOf": [
        { "type": "integer", "minimum": -9999, "maximum": 9999 },
        { "type": "string", "maxLength": 8, "pattern": "^[^\\n\\r]*\\S[^\\n\\r]*$" }
      ]
    },
    "structureParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "description": "A data structure whose states the runtime computes from operations. items are the initial contents (an array needs at least one; at most 12, or 10 for a stack and a queue); buckets and hash apply to a hashTable only; a tree and a mod hash table take whole numbers, a charSum hash table takes text.",
      "properties": {
        "kind": { "enum": ["array", "stack", "queue", "hashTable", "tree"] },
        "items": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/structureValue" } },
        "buckets": { "type": "integer", "minimum": 2, "maximum": 8, "default": 5 },
        "hash": { "enum": ["mod", "charSum"], "default": "mod", "description": "mod: the whole-number key itself; charSum: the sum of the characters' code points. Both are reduced modulo the bucket count." }
      }
    },
    "diagramLine": {
      "type": "string",
      "pattern": "^[^\\n\\r]*\\S[^\\n\\r]*$"
    },
    "diagramNodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": { "$ref": "#/$defs/id" }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object", "action"],
      "properties": {
        "object": { "$ref": "#/$defs/id" },
        "action": { "enum": ["show", "hide", "focus", "clear", "set", "rotate", "reset", "highlight", "dim", "reveal", "trace", "annotate", "swap", "compare", "push", "pop", "peek", "enqueue", "dequeue", "insert", "lookup", "remove"] },
        "params": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "focus" } } },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["lines"],
                "properties": {
                  "lines": {
                    "type": "array",
                    "prefixItems": [{ "type": "integer", "minimum": 1 }, { "type": "integer", "minimum": 1 }],
                    "minItems": 2,
                    "maxItems": 2,
                    "description": "[start, end], 1-based and inclusive."
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "rotate" } } },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "rx": { "type": "number" },
                  "ry": { "type": "number" },
                  "rz": { "type": "number" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "set" } } },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "text": { "$ref": "#/$defs/headlineText" },
                  "shape": { "enum": ["cube", "cylinder", "cone", "sphere", "torus"] },
                  "wireframe": { "type": "boolean" },
                  "index": { "type": "integer", "description": "Array only: with value." },
                  "value": { "$ref": "#/$defs/structureValue" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "action": { "enum": ["highlight", "dim"] } } },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "nodes": { "$ref": "#/$defs/diagramNodes" },
                  "indexes": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "integer", "minimum": 0 }, "description": "Array highlight." },
                  "key": { "type": "integer", "description": "Tree highlight: marks the path to this key." }
                },
                "minProperties": 1
              }
            }
          }
        },
        {
          "if": { "properties": { "action": { "enum": ["swap", "compare"] } } },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["indexes"],
                "properties": { "indexes": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 0 } } }
              }
            }
          }
        },
        {
          "if": { "properties": { "action": { "enum": ["push", "enqueue"] } } },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["value"],
                "properties": { "value": { "$ref": "#/$defs/structureValue" } }
              }
            }
          }
        },
        {
          "if": { "properties": { "action": { "enum": ["insert", "lookup", "remove"] } } },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["key"],
                "properties": { "key": { "$ref": "#/$defs/structureValue" } }
              }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "reveal" } } },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["from", "to"],
                "properties": { "from": { "$ref": "#/$defs/id" }, "to": { "$ref": "#/$defs/id" } }
              }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "trace" } } },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path"],
                "properties": {
                  "path": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 30,
                    "items": { "$ref": "#/$defs/id" },
                    "description": "Each consecutive pair must be an edge, in its direction."
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "annotate" } } },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["node", "text"],
                "properties": {
                  "node": { "$ref": "#/$defs/id" },
                  "text": { "$ref": "#/$defs/diagramLine", "maxLength": 60 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "action": { "enum": ["show", "hide", "clear", "reset", "pop", "peek", "dequeue"] } } },
          "then": { "properties": { "params": { "type": "object", "maxProperties": 0 } } }
        }
      ]
    }
  }
}
