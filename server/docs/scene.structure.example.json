  "steps": [
    { "id": "array", "say": "An array is numbered cells. Compare the first two, then swap them." },
    { "id": "stack", "say": "A stack gives back the last item in first: push a three, then pop it." },
    { "id": "queue", "say": "A queue serves in arrival order: enqueue a c, then dequeue the oldest." },
    { "id": "collide", "say": "A hash table turns a key into a bucket. Seventeen and twelve both land in bucket two, so they chain." },
    { "id": "find", "say": "Looking up seventeen follows the chain of its bucket." },
    { "id": "tree", "say": "In a search tree, smaller keys go left and larger go right. Inserting seven walks down from the root." }
